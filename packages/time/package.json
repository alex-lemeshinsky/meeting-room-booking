{
  "name": "@mrb/time",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./calendar": {
      "types": "./src/calendar.ts",
      "default": "./dist/calendar.js"
    },
    "./interval": {
      "types": "./src/interval.ts",
      "default": "./dist/interval.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "3.7.2"
  }
}
