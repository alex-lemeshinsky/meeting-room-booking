{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API (NestJS)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "node",
      "runtimeVersion": "24.18.0",
      "runtimeArgs": [
        "--inspect=9229",
        "--watch",
        "--import",
        "tsx",
        "src/main.ts"
      ],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug web (Next.js)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/web",
      "runtimeExecutable": "node",
      "runtimeVersion": "24.18.0",
      "runtimeArgs": ["./node_modules/next/dist/bin/next", "dev"],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Debug full stack",
      "configurations": ["Debug API (NestJS)", "Debug web (Next.js)"],
      "stopAll": true
    }
  ]
}
