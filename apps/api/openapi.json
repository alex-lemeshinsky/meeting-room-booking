  "info": {
    "title": "Meeting Room Booking API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mrb_session"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Олена"
          },
          "email": {
            "type": "string",
            "example": "olena@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "Rooms123!",
            "format": "password",
            "minLength": 8
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "PublicUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Олена"
          },
          "email": {
            "type": "string",
            "example": "olena@example.com",
            "format": "email"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/PublicUserDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "olena@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "Rooms123!",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RoomDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Dnipro"
          },
          "floor": {
            "type": "number",
            "example": 4,
            "minimum": 1
          },
          "capacity": {
            "type": "number",
            "example": 10,
            "minimum": 1
          }
        },
        "required": [
          "id",
          "name",
          "floor",
          "capacity"
        ]
      },
      "RoomListResponseDto": {
        "type": "object",
        "properties": {
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomDto"
            }
          }
        },
        "required": [
          "rooms"
        ]
      }
    }
  }
}
