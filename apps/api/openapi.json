  "info": {
    "title": "Meeting Room Booking API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mrb_session"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Олена"
          },
          "email": {
            "type": "string",
            "example": "olena@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "Rooms123!",
            "format": "password",
            "minLength": 8
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "PublicUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Олена"
          },
          "email": {
            "type": "string",
            "example": "olena@example.com",
            "format": "email"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/PublicUserDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "ApiErrorDetailsDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Request validation failed"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "requestId": {
            "type": "string",
            "example": "b6a3a1f7-07d8-4fd8-a0c5-ff1f5aa9b568"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetailsDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "olena@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "Rooms123!",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ScheduleParamsDto": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "roomId"
        ]
      },
      "ScheduleQueryDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date-time",
            "example": "2035-01-01T00:00:00.000Z"
          },
          "to": {
            "type": "string",
            "format": "date-time",
            "example": "2035-01-08T00:00:00.000Z"
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "RoomDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Dnipro"
          },
          "floor": {
            "type": "number",
            "example": 4,
            "minimum": 1
          },
          "capacity": {
            "type": "number",
            "example": 10,
            "minimum": 1
          }
        },
        "required": [
          "id",
          "name",
          "floor",
          "capacity"
        ]
      },
      "RoomListResponseDto": {
        "type": "object",
        "properties": {
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomDto"
            }
          }
        },
        "required": [
          "rooms"
        ]
      },
      "ScheduleOrganizerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Олена"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "ScheduleBookingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "example": "Планування спринту"
          },
          "startAt": {
            "type": "string",
            "format": "date-time",
            "example": "2035-01-02T10:00:00.000Z"
          },
          "endAt": {
            "type": "string",
            "format": "date-time",
            "example": "2035-01-02T11:00:00.000Z"
          },
          "organizer": {
            "$ref": "#/components/schemas/ScheduleOrganizerDto"
          },
          "isOwn": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "id",
          "title",
          "startAt",
          "endAt",
          "organizer",
          "isOwn"
        ]
      },
      "ScheduleResponseDto": {
        "type": "object",
        "properties": {
          "room": {
            "$ref": "#/components/schemas/RoomDto"
          },
          "from": {
            "type": "string",
            "format": "date-time",
            "example": "2035-01-01T00:00:00.000Z"
          },
          "to": {
            "type": "string",
            "format": "date-time",
            "example": "2035-01-08T00:00:00.000Z"
          },
          "bookings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleBookingDto"
            }
          }
        },
        "required": [
          "room",
          "from",
          "to",
          "bookings"
        ]
      }
    }
  }
}
