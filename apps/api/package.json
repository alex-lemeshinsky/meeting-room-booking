{
  "name": "@mrb/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:time && nest build",
    "build:time": "pnpm --filter @mrb/time build",
    "dev": "pnpm run build:time && tsx watch src/main.ts",
    "lint": "eslint src test",
    "openapi:generate": "pnpm run build:time && tsx scripts/generate-openapi.ts",
    "start": "pnpm run build:time && node dist/main.js",
    "test:unit": "pnpm run build:time && vitest run --exclude '**/*.integration-spec.ts'",
    "test:integration": "pnpm run build:time && vitest run --maxWorkers=1 integration-spec.ts",
    "typecheck": "pnpm run build:time && prisma generate --schema ../../prisma/schema.prisma && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mrb/time": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "pg": "^8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@testcontainers/postgresql": "12.0.4",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1"
  }
}
